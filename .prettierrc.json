{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "packages/ui/**",
      "options": {
        "tailwindStylesheet": "./packages/ui/src/index.css",
        "tailwindFunctions": ["cn", "cva"]
      }
    }
  ]
}
