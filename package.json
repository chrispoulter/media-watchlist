{
    "name": "media-watchlist",
    "private": true,
    "version": "1.0.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "npm@11.13.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:infra:up": "docker compose up -d --wait postgres mailpit",
        "docker:infra:down": "docker compose stop postgres mailpit",
        "docker:up": "docker compose up -d --build --wait",
        "docker:down": "docker compose down"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "turbo": "^2.11.6"
    }
}
