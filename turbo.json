{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CLIENT_ORIGIN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "TMDB_API_READ_TOKEN",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_FROM",
        "SMTP_USER",
        "SMTP_PASS",
        "LOG_LEVEL"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"],
            "env": ["VITE_API_URL"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "lint:fix": {
            "cache": false
        }
    }
}
