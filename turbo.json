{
    "$schema": "https://v2-11-6.turborepo.dev/schema.json",
    "globalPassThroughEnv": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TRUSTED_ORIGINS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "TMDB_API_READ_TOKEN",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_FROM_ADDRESS",
        "SMTP_FROM_NAME",
        "SMTP_USER",
        "SMTP_PASS",
        "LOG_LEVEL",
        "API_URL",
        "VERCEL_GIT_COMMIT_SHA",
        "GIT_COMMIT_SHA"
    ],
    "tasks": {
        "build": {
            "env": ["GIT_COMMIT_SHA", "npm_package_version"],
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "lint:fix": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        }
    }
}
