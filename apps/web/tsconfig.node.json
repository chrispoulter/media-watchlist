{
  "extends": "@media-watchlist/typescript-config/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"],

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Linting */
    "erasableSyntaxOnly": true
