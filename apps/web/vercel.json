{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "npm install --workspace=@media-watchlist/web",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "$API_URL/api/:path*",
            "env": ["API_URL"]
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
