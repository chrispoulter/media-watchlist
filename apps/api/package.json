{
    "name": "@media-watchlist/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "email:dev": "email dev -p 3001 -d src/emails"
    },
    "dependencies": {
        "@media-watchlist/shared": "*",
        "@react-email/ui": "^6.6.5",
        "@scalar/express-api-reference": "^0.10.7",
        "better-auth": "^1.6.23",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-email": "^6.6.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@media-watchlist/eslint-config": "*",
        "@media-watchlist/typescript-config": "*",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "drizzle-kit": "^0.31.10",
        "globals": "^17.12.0",
        "openapi-types": "^12.1.3",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3"
    }
}
